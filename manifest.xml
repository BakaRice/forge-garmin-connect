<?xml version="1.0"?>
<!--
  Forge — Watch App for Garmin Forerunner 255 (docs/README.md §18)
  V1 只支持 FR255，不追求兼容整个产品线。
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="14c9462f-1257-44dc-9f0d-7d91d56877b0"
        type="watch-app"
        name="@Strings.AppName"
        entry="ForgeApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.0">
        <iq:products>
            <!-- V1 首发设备: Forerunner 255 -->
            <iq:product id="fr255"/>
        </iq:products>
        <iq:permissions>
            <!-- docs/update.md §5.1: ActivityRecording 需要 Fit 权限 -->
            <iq:uses-permission id="Fit"/>
            <!-- docs/update.md §5.1: Toybox.Sensor 需要 Sensor 权限 (Phase B 心率) -->
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>
        <iq:languages>
            <!-- 中文为第一语言, 英文次之 -->
            <iq:language>chi</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
